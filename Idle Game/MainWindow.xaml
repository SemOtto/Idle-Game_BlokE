<Window
    x:Class="Idle_Game.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#0B1020">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#111A30"
            Padding="25">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="🚀 SPACE TYCOON"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Bouw je eigen ruimte-imperium"
                        FontSize="14"
                        Foreground="#9BA8C7"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right">

                    <TextBlock
                        x:Name="GalaxyPointsText"
                        Text="⭐ Galaxy Points: 0"
                        FontSize="16"
                        Foreground="#FFD54F"
                        HorizontalAlignment="Right"/>

                    <Button
                        x:Name="SaveButton"
                        Content="💾 Opslaan"
                        Click="SaveButton_Click"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid
            Grid.Row="1"
            Padding="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="0,0,15,0">

                <Border
                    Background="#111A30"
                    CornerRadius="15"
                    Padding="25">

                    <StackPanel>

                        <TextBlock
                            Text="💰 Jouw Credits"
                            FontSize="18"
                            Foreground="#9BA8C7"/>

                        <TextBlock
                            x:Name="CreditsText"
                            Text="0"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,5,0,0"/>

                        <TextBlock
                            x:Name="IncomeText"
                            Text="+0/sec"
                            FontSize="20"
                            Foreground="#64E572"
                            Margin="0,5,0,0"/>

                        <TextBlock
                            x:Name="ManualPowerText"
                            Text="+10 per klik"
                            FontSize="14"
                            Foreground="#9BA8C7"
                            Margin="0,5,0,20"/>

                        <Button
                            x:Name="MineButton"
                            Content="⛏️ MIJN GRONDSTOFFEN"
                            FontSize="18"
                            Height="60"
                            Click="MineButton_Click"/>

                    </StackPanel>

                </Border>

                <Border
                    Background="#17142B"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,15,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="🌌 Nieuwe Melkweg"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#D6B8FF"/>

                        <TextBlock
                            Text="Reset je voortgang en ontvang een permanente +10% productie per Galaxy Point."
                            TextWrapping="Wrap"
                            Foreground="#9BA8C7"
                            Margin="0,8,0,12"/>

                        <TextBlock
                            x:Name="PrestigeRequirementText"
                            Text="Vereist: 10.000.000 credits"
                            Foreground="#9BA8C7"
                            Margin="0,0,0,10"/>

                        <Button
                            x:Name="PrestigeButton"
                            Content="🌌 START NIEUWE MELKWEG"
                            Click="PrestigeButton_Click"/>

                    </StackPanel>

                </Border>

            </StackPanel>

            <Border
                Grid.Column="1"
                Background="#111A30"
                CornerRadius="15"
                Padding="20">

                <ScrollViewer>

                    <StackPanel>

                        <TextBlock
                            Text="🏗️ Ruimte-industrie"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,0,0,15"/>

                        <ItemsControl
                            x:Name="BuildingsList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Background="#19233D"
                                        CornerRadius="10"
                                        Padding="15"
                                        Margin="0,0,0,10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                                <TextBlock
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap"
                                                    Foreground="#9BA8C7"
                                                    FontSize="12"
                                                    Margin="0,4,0,0"/>

                                                <TextBlock
                                                    x:Name="AmountText"
                                                    Text="Aantal: 0"
                                                    Foreground="#64E572"
                                                    Margin="0,6,0,0"/>

                                                <TextBlock
                                                    x:Name="IncomeBuildingText"
                                                    Text="+0/sec"
                                                    Foreground="#9BA8C7"/>

                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right">

                                                <TextBlock
                                                    x:Name="PriceText"
                                                    Text="50"
                                                    FontSize="16"
                                                    Foreground="#FFD54F"
                                                    HorizontalAlignment="Right"/>

                                                <Button
                                                    Content="KOPEN"
                                                    Click="BuyBuilding_Click"
                                                    Tag="{Binding}"
                                                    Margin="0,8,0,0"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <TextBlock
                            Text="⬆️ Upgrades"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            Margin="0,20,0,15"/>

                        <ItemsControl
                            x:Name="UpgradesList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Background="#19233D"
                                        CornerRadius="10"
                                        Padding="15"
                                        Margin="0,0,0,10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                                <TextBlock
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap"
                                                    Foreground="#9BA8C7"
                                                    Margin="0,4,0,0"/>

                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Content="KOPEN"
                                                Tag="{Binding}"
                                                Click="BuyUpgrade_Click"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <Border
            Grid.Row="2"
            Background="#080C17"
            Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Text="📜 Productielog"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"/>

                <ListView
                    x:Name="LogList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,5,0,0">

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Window>